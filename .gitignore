# Raw and processed data
data/

*.dta
*.sav
*.parquet
*.feather

# Ignore CSV files containing data or saved artifacts
data/**/*.csv
artifacts/**/*.csv

# Serialized preprocessing and model artifacts
artifacts/

*.joblib
*.pkl
*.pickle

# NumPy arrays and large generated objects
*.npy
*.npz

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Jupyter temporary files
.ipynb_checkpoints/

# Operating system files
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Logs
*.log

# Environment variables and secrets
.env
.env.*

# Build artifacts
build/
dist/
*.egg-info/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp
~$*